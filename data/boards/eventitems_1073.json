,{"EventItemId":16552,"EventItemGuid":"2409BD0B-BC7E-4B4A-8538-4913566BEC5F","EventItemLastModifiedUtc":"2020-07-01T22:07:45.403","EventItemRowVersion":"AAAAAAAx9Ck=","EventItemEventId":1073,"EventItemAgendaSequence":6,"EventItemMinutesSequence":6,"EventItemAgendaNumber":"1.","EventItemVideo":22520,"EventItemVideoIndex":154,"EventItemVersion":"1","EventItemAgendaNote":null,"EventItemMinutesNote":null,"EventItemActionId":null,"EventItemActionName":null,"EventItemActionText":null,"EventItemPassedFlag":null,"EventItemPassedFlagName":null,"EventItemRollCallFlag":0,"EventItemFlagExtra":0,"EventItemTitle":"Request for the Planning Commission’s recommendation on a final plat for a proposed re-subdivision of  4-lot existing  lots 77, 78, 79, and 80 located at 101, 103, and 201 Mashie Drive as well as 701 Maple Drive into 6 new lots in the RS-16 zone and two waivers of subdivision requirements.\n\nThis is a RS-16, by-right, low-density, single-family residential application. It is consistent with the land-use map in the 2015 Comprehensive Plan update and current Zoning Map. The 6-lot proposal maintains the current RS-16 (Single Family Detached Residential) zone. The proposed development meets all zoning ordinance requirements of the RS-16 (Single Family Detached Residential) district as detailed in the attached staff report. However, the applicant has requested two waivers as provided for in Section 17-12 of the Towns subdivision ordinance. The project as proposed needs a waiver from Town Council for the lot deviation of more than 3 feet to accommodate needed grading/fill to build the cul-de-sac. A waiver is also being requested for the required construction of sidewalk along Follin Lane SE.  \n\nDepartmental Recommendation: Staff recommends that the planning Commission recommends that Town Council approve the 6 lot subdivision on a cul-de-sac off Mashie Drive and approve Mashie Drive, LLC’s request for waivers of the sidewalk requirement on Follin Lane and requested lot grade deviation. \n\n\n\nPROPOSED/SUGGESTED MOTION","EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":0,"EventItemMoverId":null,"EventItemMover":null,"EventItemSeconderId":null,"EventItemSeconder":null,"EventItemMatterId":2316,"EventItemMatterGuid":"6939A6CB-1FBF-4F32-8442-DA8C9E1C9E47","EventItemMatterFile":"PC16-020","EventItemMatterName":null,"EventItemMatterType":"Planning Agenda Item","EventItemMatterStatus":"Agenda Ready","EventItemMatterAttachments":[]},{"EventItemId":16553,"EventItemGuid":"A1C2C329-5649-4392-9F2D-59F22D23EE95","EventItemLastModifiedUtc":"2020-07-01T22:09:58.15","EventItemRowVersion":"AAAAAAAx9DE=","EventItemEventId":1073,"EventItemAgendaSequence":7,"EventItemMinutesSequence":7,"EventItemAgendaNumber":"2.","EventItemVideo":22527,"EventItemVideoIndex":2008,"EventItemVersion":"1","EventItemAgendaNote":null,"EventItemMinutesNote":null,"EventItemActionId":null,"EventItemActionName":null,"EventItemActionText":null,"EventItemPassedFlag":null,"EventItemPassedFlagName":null,"EventItemRollCallFlag":0,"EventItemFlagExtra":0,"EventItemTitle":"Request for Site Plan Modifications for 135 Center Street South Development","EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":0,"EventItemMoverId":null,"EventItemMover":null,"EventItemSeconderId":null,"EventItemSeconder":null,"EventItemMatterId":2320,"EventItemMatterGuid":"F03F92DC-F85E-462D-8B36-180439DD7F20","EventItemMatterFile":"PC16-021","EventItemMatterName":null,"EventItemMatterType":"Planning Agenda Item","EventItemMatterStatus":"Agenda Ready","EventItemMatterAttachments":[]},{"EventItemId":16555,"EventItemGuid":"ADC93526-FA83-4491-AB82-6E832A9587FF","EventItemLastModifiedUtc":"2020-07-01T22:11:20.05","EventItemRowVersion":"AAAAAAAx9E8=","EventItemEventId":1073,"EventItemAgendaSequence":8,"EventItemMinutesSequence":8,"EventItemAgendaNumber":null,"EventItemVideo":22537,"EventItemVideoIndex":null,"EventItemVersion":null,"EventItemAgendaNote":null,"EventItemMinutesNote