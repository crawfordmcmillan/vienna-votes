[{"EventItemId":23131,"EventItemGuid":"9B176CE8-4D38-4841-9FE2-83AFBDEEFFFA","EventItemLastModifiedUtc":"2020-09-28T17:10:34.56","EventItemRowVersion":"AAAAAAA0ujg=","EventItemEventId":1596,"EventItemAgendaSequence":2,"EventItemMinutesSequence":2,"EventItemAgendaNumber":null,"EventItemVideo":63204,"EventItemVideoIndex":null,"EventItemVersion":"1","EventItemAgendaNote":null,"EventItemMinutesNote":null,"EventItemActionId":null,"EventItemActionName":null,"EventItemActionText":"The Board of Architectural Review met in regular session at 7:30 PM on Tuesday, August 20, 2020 in the Vienna Town Hall at 127 Center St S. and Via Zoom Webinar  to discuss six agenda items. Chairman Roy Baldwin, Vice-Chair Michael Cheselka, Paul Layer, Patty Hanley, and Linda van Doorn were present participating via Zoom.  Planner Andrea West also participated via Zoom and Principal Planner Kelly O’Brien and Board Clerk Sharmaine Abaied were present in Town Hall.  \r\n\r\nResolution for Continuity of Government\r\nRoll call vote: 5-0\r\nAyes: Ms. van Doorn, Mr. Layer, Mr. Baldwin, Mr. Cheselka, and Ms. Hanley\r\n\r\n","EventItemPassedFlag":null,"EventItemPassedFlagName":null,"EventItemRollCallFlag":0,"EventItemFlagExtra":0,"EventItemTitle":"Resolution for Continuity of Government - August 20, 2020","EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":0,"EventItemMoverId":null,"EventItemMover":null,"EventItemSeconderId":null,"EventItemSeconder":null,"EventItemMatterId":3609,"EventItemMatterGuid":"7BF32684-3252-4370-A693-D22D9F4C677D","EventItemMatterFile":"BAR20-175","EventItemMatterName":null,"EventItemMatterType":"BAR Agenda Item","EventItemMatterStatus":"Agenda Ready","EventItemMatterAttachments":[]},{"EventItemId":23132,"EventItemGuid":"9B406363-7704-4374-A9EB-91399EF1455C","EventItemLastModifiedUtc":"2020-09-28T17:11:03.36","EventItemRowVersion":"AAAAAAA0ulU=","EventItemEventId":1596,"EventItemAgendaSequence":6,"EventItemMinutesSequence":6,"EventItemAgendaNumber":null,"EventItemVideo":63210,"EventItemVideoIndex":null,"EventItemVersion":"1","EventItemAgendaNote":null,"EventItemMinutesNote":null,"EventItemActionId":null,"EventItemActionName":null,"EventItemActionText":"Request for approval of a new sign for Aditi Gourmet (formerly Kochin Kitchen) located at 405 Maple Avenue E, Docket No. PF-31-20-BAR, in the C-2 General Commercial district; filed by Suku Nair, business owner.\r\n\r\nMr. Cheselka was not in favor of the new submission as he felt the sign was too cluttered.  The remaining Board members were agreeable to the change in the sign.  \r\n\r\nMotion to approve: Hanley\r\nSecond: Layer\r\nApproved: 4-1\r\nAyes: Ms. van Doorn, Mr. Layer, Mr. Baldwin, and Ms. Hanley\r\nNay: Cheselka \r\n","EventItemPassedFlag":null,"EventItemPassedFlagName":null,"EventItemRollCallFlag":0,"EventItemFlagExtra":0,"EventItemTitle":"405 Maple Ave E - Aditi Gourment - Sign","EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":0,"EventItemMoverId":null,"EventItemMover":null,"EventItemSeconderId":null,"EventItemSeconder":null,"EventItemMatterId":3610,"EventItemMatterGuid":"4E3EFE7D-B0D0-4662-86C0-5572BF12FFD7","EventItemMatterFile":"BAR20-176","EventItemMatterName":null,"EventItemMatterType":"BAR Agenda Item","EventItemMatterStatus":"Agenda Ready","EventItemMatterAttachments":[]},{"EventItemId":23133,"EventItemGuid":"AB78C3FC-BE6D-458A-A967-73DFCE7DF08E","EventItemLastModifiedUtc":"2020-09-28T17:11:40.657","EventItemRowVersion":"AAAAAAA0unI=","EventItemEventId":1596,"EventItemAgendaSequence":7,"EventItemMinutesSequence":7,"EventItemAgendaNumber":null,"EventItemVideo":63215,"EventItemVideoIndex":null,"EventItemVersion":"1","EventItemAgendaNote":null,"EventItemMinutesNote":null,"EventItemActionId":null,"EventItemActionName":null,"EventItemActionText":"Request for approval of Vienna Market, a new mixed-use project, at the former Marco Polo Restaurant site, located at 245 Maple Avenue W., Docket No. 21-19-BAR, in the MAC Maple Avenue Commercial Zone zoning district; filed by Chilton MacGregor of NV Homes.\r\n\r\nThe applicants asked staff to defer their agenda item as they did not have every change to the application ready and needed another month to have all materials complete.  \r\n\r\nMotion to table request: van Doorn\r\nSecond: Layer\r\nApproved: 5-0\r\nAyes: Ms. van Doorn, Mr. Layer, Mr. Baldwin, Mr. Cheselka, and Ms. Hanley\r\n","EventItemPassedFlag":null,"EventItemPassedFlagName":null,"EventItemRollCallFlag":0,"EventItemFlagExtra":0,"EventItemTitle":"245 Maple Ave W - Vienna Market - Exterior Modificaitons","EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":0,"EventItemMoverId":null,"EventItemMover":null,"EventItemSeconderId":null,"EventItemSeconder":null,"EventItemMatterId":3611,"EventItemMatterGuid":"AF3ACBCB-3F19-4BDC-B132-91412D56F5FE","EventItemMatterFile":"BAR20-177","EventItemMatterName":null,"EventItemMatterType":"BAR Agenda Item","EventItemMatterStatus":"Agenda Ready","EventItemMatterAttachments":[]},{"EventItemId":23134,"EventItemGuid":"B3E83D0C-3F4C-49C0-9EA5-E7D95D62B34B","EventItemLastModifiedUtc":"2020-09-28T17:11:52.783","EventItemRowVersion":"AAAAAAA0unk=","EventItemEventId":1596,"EventItemAgendaSequence":8,"EventItemMinutesSequence":8,"EventItemAgendaNumber":null,"EventItemVideo":63239,"EventItemVideoIndex":null,"EventItemVersion":"1","EventItemAgendaNote":null,"EventItemMinutesNote":null,"EventItemActionId":null,"EventItemActionName":null,"EventItemActionText":"Request for approval of a new generator enclosure located at 127 Center Street S., Docket No. PF-21-20-BAR, in the RM-2 Multi-Family Residential zoning district; filed by David Donahue, Deputy Director of Public Works, Town of Vienna.\r\n\r\nThe applicant asked to amend the application to omit the fence that was originally submitted to assist with air flow as well as stating it would be more aesthetically pleasing. \r\n\r\nMs. van Doorn felt black powder coated aluminum fencing would look better and provide protection.  She was not in favor of omitting the fencing.\r\n\r\nThe project manager from CAT Alban explained the location of the bollards stating they would provide protection.\r\n\r\nThere was additional discussion regarding the fencing and bollards.\r\n\r\nMotion to approve with the condition that the fencing be removed, a fifth bollard added, a bollard placed on each end, and equally spaced: Cheselka\r\nSecond: Hanley\r\nApproved: 4-1\r\nAyes: Mr. Layer, Mr. Baldwin, Mr. Cheselka, and Ms. Hanley\r\nNay: van Doorn\r\n","EventItemPassedFlag":null,"EventItemPassedFlagName":null,"EventItemRollCallFlag":0,"EventItemFlagExtra":0,"EventItemTitle":"127 Center St S - Town Hall Generator - Exterior Modification","EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":0,"EventItemMoverId":null,"EventItemMover":null,"EventItemSeconderId":null,"EventItemSeconder":null,"EventItemMatterId":3612,"EventItemMatterGuid":"4CB59A6A-AB18-4194-AD08-184BAAF8404B","EventItemMatterFile":"BAR20-178","EventItemMatterName":null,"EventItemMatterType":"BAR Agenda Item","EventItemMatterStatus":"Agenda Ready","EventItemMatterAttachments":[]},{"EventItemId":23135,"EventItemGuid":"BE06AAED-F97C-4A6B-AEBB-3F95046CC565","EventItemLastModifiedUtc":"2020-09-28T17:12:04.97","EventItemRowVersion":"AAAAAAA0uoQ=","EventItemEventId":1596,"EventItemAgendaSequence":10,"EventItemMinutesSequence":10,"EventItemAgendaNumber":null,"EventItemVideo":63248,"EventItemVideoIndex":null,"EventItemVersion":"1","EventItemAgendaNote":null,"EventItemMinutesNote":null,"EventItemActionId":null,"EventItemActionName":null,"EventItemActionText":"Request for approval of multiple freestanding signs for the Navy Federal Credit Union located at 820 Follin Lane SE, Docket No. PF-36-20-BAR, in the CMP Industrial Park zoning district; filed by Stacey Purinton, Facilities Manager, Navy Federal Credit Union.\r\n\r\nMr. Purinton stated 1.001/2 was shown in drawing on the wrong side of the street.  The correction will be made. \r\n\r\nMs. Hanley inquired about the lighting on the signs and Mr. Purinton stated, only the main entrance sign would be lit with same specifications of the other entrance sign that was approved in 2019.  \r\n\r\nMotion to approve with sign 1.001/2 be relocated, per correction stated by Mr. Purinton, and provide documentation of correction to staff.\r\nMotion: Hanley\r\nSecond: Cheselka\r\nApproved: 5-0\r\nAyes: Ms. van Doorn, Mr. Layer, Mr. Baldwin, Mr. Cheselka, and Ms. Hanley\r\n\r\n","EventItemPassedFlag":null,"EventItemPassedFlagName":null,"EventItemRollCallFlag":0,"EventItemFlagExtra":0,"EventItemTitle":"820 Follin Ln SE - Navy Federal Credit Union - Signs","EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":0,"EventItemMoverId":null,"EventItemMover":null,"EventItemSeconderId":null,"EventItemSeconder":null,"EventItemMatterId":3613,"EventItemMatterGuid":"38B8BCEC-4001-46C6-85D2-FDE32403CD50","EventItemMatterFile":"BAR20-179","EventItemMatterName":null,"EventItemMatterType":"BAR Agenda Item","EventItemMatterStatus":"Agenda Ready","EventItemMatterAttachments":[]},{"EventItemId":23136,"EventItemGuid":"3C6C4159-5D10-4FB6-B3E0-E89AD0D1206F","EventItemLastModifiedUtc":"2020-09-28T17:12:17.22","EventItemRowVersion":"AAAAAAA0uo8=","EventItemEventId":1596,"EventItemAgendaSequence":11,"EventItemMinutesSequence":11,"EventItemAgendaNumber":null,"EventItemVideo":63255,"EventItemVideoIndex":null,"EventItemVersion":"1","EventItemAgendaNote":null,"EventItemMinutesNote":null,"EventItemActionId":null,"EventItemActionName":null,"EventItemActionText":"Request for approval of a new wall sign for Verizon Wireless located at 301 Maple Ave W, Docket No. PF-38-20-BAR, in the C-1A Special Commercial zoning district; filed by Chelsey Bashorun, of Signarama.\r\n\r\nThe Board discussed the lumen levels, stating 100-150 is the typical lumen level the Board has agreed upon in the past.\r\n\r\nMotion to approve with maximum lumen levels of 150 and kelvins 