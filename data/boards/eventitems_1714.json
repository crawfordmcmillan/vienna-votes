pe":null,"EventItemMatterStatus":null,"EventItemMatterAttachments":[]},{"EventItemId":24327,"EventItemGuid":"EBA7D506-B9FF-47F9-8F23-667A9268F746","EventItemLastModifiedUtc":"2021-03-19T14:01:11.313","EventItemRowVersion":"AAAAAAA5Uuk=","EventItemEventId":1714,"EventItemAgendaSequence":4,"EventItemMinutesSequence":4,"EventItemAgendaNumber":null,"EventItemVideo":72185,"EventItemVideoIndex":null,"EventItemVersion":"1","EventItemAgendaNote":null,"EventItemMinutesNote":null,"EventItemActionId":null,"EventItemActionName":null,"EventItemActionText":"Mr. Sekas was present to discuss changes to the Cadence on Park.  \r\n\r\nMr. Baldwin asked Mr. Sekas to explain the changes he was presenting to the board.  The changes were as follows:\r\n\r\n-\tThe siding was lightened to look more like taupe (the same color used on Cadence on Center).\r\n-\tTriangle head features for units 2 and 4.\r\n-\tBlack metal roof on the porticos for units 1 through 5. \r\n-\tUnit 1 changed to gray rather than brick.\r\n-\tLandscaping would be added.\r\no\tBushes in between the side of the building and the back of the curb\r\no\tLandscaping in front of all the units per the rendering\r\no\tAddition of the twenty-three trees (per the original submission)\r\no\tSome shrubbery by the wall\r\n\r\nThe board like the changes that were made.  There was a request that the lighting package with the lumens and kelvins identified when submitting for the next public hearing for final approval.\r\n\r\n\r\nThe meeting was adjourned at 8:30 am\r\n\r\nRespectfully Submitted, \r\nSharmaine Abaied\r\nBoard Clerk\r\n","EventItemPassedFlag":null,"EventItemPassedFlagName":null,"EventItemRollCallFlag":0,"EventItemFlagExtra":0,"EventItemTitle":"201 Park St SE - Cadence on Park","EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":0,"EventItemMoverId":null,"EventItemMover":null,"EventItemSeconderId":null,"EventItemSeconder":null,"EventItemMatterId":3913,"EventItemMatterGuid":"22DF4C55-33AB-4233-B98C-24FF