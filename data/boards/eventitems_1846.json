[{"EventItemId":25877,"EventItemGuid":"67840F91-BA20-4949-946D-D18F6E8750E3","EventItemLastModifiedUtc":"2021-09-01T14:49:49.12","EventItemRowVersion":"AAAAAABCfD8=","EventItemEventId":1846,"EventItemAgendaSequence":3,"EventItemMinutesSequence":3,"EventItemAgendaNumber":null,"EventItemVideo":80472,"EventItemVideoIndex":null,"EventItemVersion":null,"EventItemAgendaNote":null,"EventItemMinutesNote":null,"EventItemActionId":null,"EventItemActionName":null,"EventItemActionText":null,"EventItemPassedFlag":null,"EventItemPassedFlagName":null,"EventItemRollCallFlag":0,"EventItemFlagExtra":0,"EventItemTitle":"Work Session","EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":0,"EventItemMoverId":null,"EventItemMover":null,"EventItemSeconderId":null,"EventItemSeconder":null,"EventItemMatterId":null,"EventItemMatterGuid":null,"EventItemMatterFile":null,"EventItemMatterName":null,"EventItemMatterType":null,"EventItemMatterStatus":null,"EventItemMatterAttachments":[]},{"EventItemId":25878,"EventItemGuid":"6D6CECB6-0F64-408A-84BC-A0BF5E4D3A73","EventItemLastModifiedUtc":"2021-09-17T15:57:18.727","EventItemRowVersion":"AAAAAABC8RU=","EventItemEventId":1846,"EventItemAgendaSequence":2,"EventItemMinutesSequence":2,"EventItemAgendaNumber":null,"EventItemVideo":80469,"EventItemVideoIndex":null,"EventItemVersion":"1","EventItemAgendaNote":null,"EventItemMinutesNote":null,"EventItemActionId":null,"EventItemActionName":null,"EventItemActionText":"Resolution for Continuity of Government \r\n\r\nRoll Call: Mr. Layer, Mr. Baldwin, Mr. Cheselka, and Ms. Hanley were present. Ms. van Doorn was absent\r\n","EventItemPassedFlag":null,"EventItemPassedFlagName":null,"EventItemRollCallFlag":0,"EventItemFlagExtra":0,"EventItemTitle":"Board of Architectural Review - Continuity of Government","EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":0,"EventItemMoverId":null,"EventItemMover":null,"EventItemSeconderId":null,"EventItemSeconder":null,"EventItemMatterId":4295,"EventItemMatterGuid":"3EDE822E-FF61-434B-99DE-C1BDC278358A","EventItemMatterFile":"BARWS21-041","EventItemMatterName":null,"EventItemMatterType":"BAR Work Session Item","EventItemMatterStatus":"Agenda Ready","EventItemMatterAttachments":[]},{"EventItemId":25879,"EventItemGuid":"FF793FE9-6301-4BDE-B620-E62A8572021D","EventItemLastModifiedUtc":"2021-10-21T19:02:15.527","EventItemRowVersion":"AAAAAABEIQ4=","EventItemEventId":1846,"EventItemAgendaSequence":4,"EventItemMinutesSequence":4,"EventItemAgendaNumber":null,"EventItemVideo":80473,"EventItemVideoIndex":null,"EventItemVersion":"1","EventItemAgendaNote":null,"EventItemMinutesNote":null,"EventItemActionId":null,"EventItemActionName":null,"EventItemActionText":"Ms. Michelle Rosati, Land Use Attorney with Holland & Knight was present representing Chase Bank for 315 Maple Ave E.  Ms. Rosati gave a presentation regarding the changes for the site.   Cody Mudd from Bohler Engineering was present as well to answer questions.  \r\n\r\nThe Board discussed the proposed changes and recommended the following:\r\n\r\n-\tPublic art \r\n-\tPick up on grid lines, have horizontal recessed areas, and banding to pick up other architecture (shadow lines)\r\n-\tNew elevations stating the direction that elevation is facing (street, business, etc.)\r\no\tClarification of elevations\r\no\tSign visibility from Maple and main entrance\r\no\tBlank elevation facing building East / Oakton – create further articulation to alleviate drabness\r\n-\tEngineering standard with lighting quality showing lowest level given respective illuminating task (ATM).\r\no\tKelvin range around 3000 \r\no\tEngineering standards of lumens and foot candles (relating to given task)\r\n \r\n\r\nThe meeting was adjourned at 7:12 pm\r\n\r\nRespectfully Submitted, \r\nSharmaine Abaied\r\nBoard Clerk\r\n\r\n\r\n\r\n","EventItemPassedFlag":null,"EventItemPassedFlagName":null,"EventItemRollCallFlag":0,"EventItemFlagExtra":0,"EventItemTitle":"315 Maple Ave E - Chase Bank - Exterior Modifications","EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":0,"EventItemMoverId":null,"EventItemMover":null,"EventItemSeconderId":null,"EventItemSeconder":null,"EventItemMatterId":4296,"EventItemMatterGuid":"DBE086E4-BA76-4BD9-83A9-85824D6AF1DB","EventItemMatterFile":"BARWS21-042","EventItemMatterName":null,"EventItemMatterType":"BAR Work Session Item","EventItemMatterStatus":"Agenda Ready","EventItemMatterAttachments":[]},{"EventItemId":25882,"EventItemGuid":"9B6706A0-5B2E-414D-9BF2-D4E2499B7A73","EventItemLastModifiedUtc":"2021-09-01T14:49:50.313","EventItemRowVersion":"AAAAAABCfEc=","EventItemEventId":1846,"EventItemAgendaSequence":5,"EventItemMinutesSequence":5,"EventItemAgendaNumber":null,"EventItemVideo":80477,"EventItemVideoIndex":null,"EventItemVersion":null,"EventItemAgendaNote":null,"EventItemMinutesNote":null,"EventItemActionId":null,"EventItemActionName":null,"EventItemActionText":null,"EventItemPassedFlag":null,"EventItemPassedFlagName":null,"EventItemRollCallFlag":0,"EventItemFlagExtra":0,"EventItemTitle":"THE TOWN OF VIENNA IS COMMITTED TO FULL COMPLIANCE WITH THE AMERICANS WITH DISABILITIES ACT STANDARDS. TRANSLATION SERVICES, ASSISTANCE OR ACCOMMODATION REQUESTS FROM PERSONS WITH DISABILITIES ARE TO BE REQUESTED NOT LESS THAN 3 WORKING DAYS BEFORE THE DAY OF THE EVENT. PLEASE CALL (703) 255-6304, OR 711 VIRGINIA RELAY SERVICE FOR THE HEARING IMPAIRED.","EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":0,"EventItemMoverId":null,"EventItemMover":null,"EventItemSeconderId":null,"EventItemSeconder":null,"EventItemMatterId":null,"EventItemMatterGuid":null,"EventItemMatterFile":null,"EventItemMatterName":null,"EventItemMatterType":null,"EventItemMatterStatus":null,"EventItemMatterAttachments":[]},{"EventItemId":25883,"EventItemGuid":"9DA35612-A1C3-4F91-AD4D-C717EA06D61D","EventItemLastModifiedUtc":"2021-09-17T15:56:40.88","EventItemRowVersion":"AAAAAABC8Q4=","EventItemEventId":1846,"EventItemA