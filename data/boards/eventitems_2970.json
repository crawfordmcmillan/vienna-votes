ve review of the draft design guidelines and discussed the proposed lighting code. During the review, areas of concern for the guidelines and lighting code were identified by Board members.  As an outcome of the discussions, the Board expressed interest in submitting a formal letter to Town Council outlining their concerns and recommended changes.\r\n","EventItemPassedFlag":null,"EventItemPassedFlagName":null,"EventItemRollCallFlag":0,"EventItemFlagExtra":0,"EventItemTitle":"Board of Architectural Review - Sign & Lighting Design Guidelines","EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":0,"EventItemMoverId":null,"EventItemMover":null,"EventItemSeconderId":null,"EventItemSeconder":null,"EventItemMatterId":7423,"EventItemMatterGuid":"8071D98A-6310-41BE-A915-301212FE83E4","EventItemMatterFile":"BARWS26-100","EventItemMatterName":null,"EventItemMatterType":"BAR Work Session Item","EventItemMatterStatus":"Agenda Ready","EventItemMatterAttachments":[]},{"EventItemId":37732,"EventItemGuid":"3E98C81D-092B-4BF4-99D3-8EB994F36325","EventItemLastModifiedUtc":"2026-05-28T14:40:34.23","EventItemRowVersion":"AAAAAACFFWE=","EventItemEventId":2970,"EventItemAgendaSequence":3,"EventItemMinutesSequence":3,"EventItemAgendaNumber":null,"EventItemVideo":155394,"EventItemVideoIndex":null,"EventItemVersion":null,"EventItemAgendaNote":null,"EventItemMinutesNote":null,"EventItemActionId":null,"EventItemActionName":null,"EventItemActionText":null,"EventItemPassedFlag":null,"EventItemPassedFlagName":null,"EventItemRollCallFlag":0,"EventItemFlagExtra":0,"EventItemTitle":null,"EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":0,"EventItemMoverId":null,"EventItemMover":null,"EventItemSeconderId":null,"EventItemSeconder":null,"EventItemMatterId":null,"EventItemMatterGuid":null,"EventItemMatterFile":null,"EventItemMatterName":null,"EventItemMatterType":null,"EventItemMatterStatus":null,"EventItemMatterAttachments":[]},{"EventItemId":37734,"EventItemGui